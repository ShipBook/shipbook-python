# Shipbook credentials: create an app at https://console.shipbook.io and copy its id and key.
SHIPBOOK_APP_ID=your_app_id_here
SHIPBOOK_APP_KEY=your_app_key_here

# Optional: print the SDK's own diagnostics (login, uploads) to stderr.
#SHIPBOOK_INNER_LOG=1

# Optional: another Shipbook API, e.g. a staging environment.
#SHIPBOOK_URL=
